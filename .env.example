# GitHub PAT com escopo `repo` para ler/escrever scripts
NEXT_PUBLIC_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_GITHUB_REPO=owner/repo
NEXT_PUBLIC_GITHUB_BRANCH=main

# URL da API de bundle (api-code-bundle-packaged)
NEXT_PUBLIC_BUNDLE_API_URL=https://sua-api.easypanel.host
NEXT_PUBLIC_BUNDLE_API_KEY=sua-api-key

# Se true, remove comentários do JS antes de enviar pro bundle
NEXT_PUBLIC_STRIP_COMMENTS=false
